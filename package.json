{
  "name": "adaptive-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository foundation for the Adaptive Learning Platform monorepo.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public --fail-on warning",
    "db:types": "supabase gen types --local > packages/domain/src/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code -- packages/domain/src/database.types.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.114.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
