{
  "name": "adaptive-learning-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository foundation for the Adaptive Learning Platform monorepo.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "mobile:android": "npm run android --workspace apps/mobile",
    "mobile:ios": "npm run ios --workspace apps/mobile",
    "mobile:test": "npm run test --workspace apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/content/tsconfig.json && tsc --noEmit -p scripts/boundary-checks/tsconfig.json && tsc --noEmit -p scripts/security/tsconfig.json && tsc --noEmit -p scripts/visual-governance/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present && eslint scripts/content scripts/boundary-checks scripts/security scripts/visual-governance -c eslint.config.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "check:mobile-boundary": "node scripts/boundary-checks/check-mobile-web-boundary.ts",
    "security:audit": "node scripts/security/check-npm-audit.mjs",
    "security:audit:review": "node scripts/security/check-npm-audit.mjs --allow-proposed",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public --fail-on warning",
    "db:types": "supabase gen types --local > packages/domain/src/database.types.ts",
    "db:types:check": "npm run db:types && git diff --exit-code -- packages/domain/src/database.types.ts",
    "content:generate": "node scripts/content/generate-seed.ts",
    "content:check": "npm run content:generate && git diff --exit-code -- supabase/seed-content",
    "content:mobile:generate": "node scripts/content/generate-mobile-projection.ts",
    "content:mobile:check": "npm run content:mobile:generate && git diff --exit-code -- apps/mobile/src/lib/lesson-content/generated",
    "content:review": "node scripts/content/generate-corpus-review.ts",
    "content:pedagogy:report": "node scripts/content/validate-pedagogy.ts",
    "content:pedagogy:check": "node scripts/content/validate-pedagogy.ts --check",
    "engine:prove": "node scripts/content/prove-cc05b-engine.ts",
    "engine:prove:check": "node scripts/content/prove-cc05b-engine.ts --check",
    "engine:dimensions": "node scripts/content/report-cc05b-dimension-coverage.ts",
    "engine:dimensions:check": "node scripts/content/report-cc05b-dimension-coverage.ts --check",
    "engine:perf": "node scripts/content/measure-cc05b-performance.ts",
    "lesson:validate": "node scripts/content/validate-lesson-plan.ts",
    "lesson:validate:check": "node scripts/content/validate-lesson-plan.ts --check",
    "lesson:review": "node scripts/content/generate-lesson-review.ts",
    "lesson:assembly:prove": "node scripts/content/prove-lesson-assembly.ts",
    "lesson:assembly:prove:check": "node scripts/content/prove-lesson-assembly.ts --check",
    "lesson:assembly:review": "node scripts/content/generate-lesson-assembly-review.ts",
    "visuals:render": "npm run visuals:render --workspace apps/mobile",
    "visuals:check": "node scripts/visual-governance/check-visual-governance.ts",
    "visuals:check:strict": "node scripts/visual-governance/check-visual-governance.ts --check",
    "visuals:audit:semantic": "node scripts/visual-governance/run-semantic-audit.ts",
    "visuals:review:record": "node scripts/visual-governance/human-review.ts record",
    "visuals:report": "node scripts/visual-governance/generate-report.ts",
    "visuals:all": "npm run visuals:render && npm run visuals:check:strict && npm run visuals:audit:semantic && npm run visuals:report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.114.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
