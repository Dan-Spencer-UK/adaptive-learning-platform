%% CC-11.8 §G2 -- version-controlled platform-flow data source.
%% ARCHITECTURAL RULE: material changes to the course-factory or learner-platform
%% architecture/process flow must update THIS file. The dashboard renders it
%% directly (Mermaid) -- it never hardcodes a duplicate diagram of its own.
%% This is a process/architecture map, not a call graph: depth stops at the
%% level a new contributor needs to orient, not at function-level detail.

flowchart TD
    subgraph FACTORY["ALP COURSE FACTORY"]
        A["A. Course Selection<br/>qualification / unit chosen for production"]
        B["B. Course Research<br/>syllabus, official sample papers, source grounding"]
        C["C. Ingestion<br/>source material -> provenance-linked raw corpus"]
        D["D. Knowledge Model<br/>governed assertions, relationships, curriculum mappings, misconceptions"]
        E["E. Lesson Creation<br/>governed lesson plans compiled from the knowledge model"]
        F["F. Visual Determination<br/>Claude classifies visual need from the governed corpus:<br/>DETERMINISTIC_TECHNICAL vs PREMIUM_CONCEPTUAL vs HYBRID"]
        G["G. Image Research<br/>ChatGPT / Product Owner sources + verifies candidate<br/>technical references (geometry, provenance, licence)"]
        H["H. Visual Production"]
        I["I. Assessment Creation<br/>question blueprints compiled deterministically; generative<br/>imagery never defines assessment answer geometry"]
        J["J. Content Release<br/>versioned ContentRelease (e.g. release.unit202.v4)"]

        A --> B --> C --> D --> E --> F
        F -- "reference required" --> G
        F -- "no reference needed" --> H
        G --> H
        E --> I
        H --> I
        I --> J
    end

    subgraph HDETAIL["H. Visual Production -- detail"]
        H1["Visual Asset Contract<br/>(Claude creates/maintains: immutable facts,<br/>required labels are part of ACCEPTANCE, prohibited changes)"]
        H2{"Production route"}
        H3["Deterministic route<br/>SVG/vector renderer -- exact geometry,<br/>labels, waveforms, assessment-state, answer-revealing annotation"]
        HG["ChatGPT / Product Owner: external reference research<br/>-> APPROVED REFERENCE HANDOVER (reference-decision authority)"]
        H4["Reference acquisition<br/>Claude downloads + caches the approved reference,<br/>SHA-256, validates real image data (never a URL alone)"]
        HP["Reference preparation<br/>crop/isolate a composite subfigure, extract a PDF page,<br/>compose a multi-source sheet -- boring, technically clear, never learner-facing"]
        H5["Gemini reference-driven redraw<br/>(implementation renderer only): prepared reference +<br/>asset contract + ALP white/light style guide -> illustration WITH required labels"]
        H6["Deterministic overlays<br/>exact geometry / topology / answer-revealing annotation only<br/>(never a substitute for a required label already missing from the raster)"]
        H7["Claude independent audit<br/>fact-by-fact PASS/FAIL/UNCERTAIN vs immutable facts<br/>+ prohibited changes -- audits pixels, not labels"]
        H8{"Audit verdict"}
        H9["Bounded automatic correction<br/>(max 1 retry per asset)"]
        H10["Human-readable review pack<br/>(PDF/JSON, reference vs final side by side)"]
        H11["Master asset + optimised production derivative"]
        H12["HUMAN_REVIEW_REQUIRED<br/>never silently promoted"]
        HD{"Assessment distractor?"}
        HDX["Governed misconception contract<br/>+ approved correct geometry -> ONE deliberate error -> audit against BOTH the correct geometry and the intended error"]

        H1 --> H2
        H2 -- "DETERMINISTIC_TECHNICAL" --> H3
        H2 -- "PREMIUM_CONCEPTUAL / HYBRID" --> HG
        HG --> H4 --> HP --> H5 --> HD
        HD -- "yes -- wrong-answer image" --> HDX --> H7
        HD -- "no -- correct image" --> H7
        H3 --> H6
        H7 --> H8
        H8 -- PASS --> H6
        H8 -- RETRY --> H9 --> H5
        H8 -- "still uncertain after retry" --> H12
        H6 --> H10
        H12 --> H10
        H10 --> H11
    end

    H --> H1
    H11 --> J

    subgraph GOV["Governance (applies across H)"]
        GA["Product Owner: final approval authority"]
        GB["ADR-0004: deterministic geometry always wins over generated imagery"]
    end
    H10 -. "sent for approval" .-> GA
    H3 -. "authoritative for exact geometry" .-> GB
    H7 -. "checked against" .-> GB

    subgraph LEARNER["LEARNER PLATFORM"]
        J --> K
        K["K. Learner Engine"]
        K1["Shared learner model<br/>(mastery gates, evidence, diagnostic confidence -- all distinct)"]
        K2["Diagnostic loop<br/>wrong answer -> relationship/formula test -> evidence-supported cause"]
        K3["MAKE ME PASS<br/>targeted remediation toward assessment readiness"]
        K4["MAKE ME UNDERSTAND<br/>deeper conceptual remediation + foundational transfer"]
        K5["Spaced retrieval<br/>scheduled review from historical evidence"]
        K6["Misconception evidence<br/>tracked per learner, tied to the originating ContentRelease"]

        K --> K1
        K1 --> K2
        K2 --> K3
        K2 --> K4
        K1 --> K5
        K2 --> K6
        K3 --> K1
        K4 --> K1
    end

    subgraph ANALYTICS["L. Analytics / Governance"]
        L1["Cohort + content-quality signals<br/>(which ContentRelease, which assertion, which misconception)"]
        L2["Feeds back into B/D/F<br/>(course research, knowledge-model gaps, visual-need re-classification)"]
    end
    K6 --> L1 --> L2
    L2 -.-> B
    L2 -.-> D
    L2 -.-> F

    classDef complete fill:#1f6f43,stroke:#153d26,color:#fff;
    classDef inprogress fill:#8a6d1a,stroke:#5a4610,color:#fff;
    classDef notstarted fill:#3a3f4c,stroke:#23262e,color:#cbd0dc;
    class A,B,C,D,E,I,J,K,K1,K2,K3,K4,K5,K6 complete;
    class F,H,H1,H2,H3,HG,H4,HP,H5,H6,H7,H8,H9,H10,H11,H12,HD,HDX,GA,GB inprogress;
    class G,L1,L2 notstarted;
