# Local Supabase only. No production/remote project is required for CC-03.
#
# 1. Run `npx supabase start` from the repository root (or `npx supabase status`
#    if it is already running).
# 2. Copy this file to `.env.local` in this directory.
# 3. Fill in the two values below from that command's output:
#      API_URL             -> NEXT_PUBLIC_SUPABASE_URL
#      PUBLISHABLE_KEY      -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#
# Never put the SECRET_KEY, SERVICE_ROLE_KEY, JWT_SECRET or database
# password here -- those are server-only local dev credentials and must
# never be read by application code or exposed to the browser.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
