# Local Supabase only. No production/remote project is required for CC-04N.
#
# 1. Run `npx supabase start` from the repository root (or `npx supabase status`
#    if it is already running).
# 2. Copy this file to `.env.local` in this directory.
# 3. Fill in EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#    from that command's output -- see the "Local Supabase connectivity" table
#    in apps/mobile/README.md, because the correct URL differs by target:
#
#      Android emulator   -> http://10.0.2.2:54321        (NOT 127.0.0.1/localhost --
#                             the emulator is a separate virtual machine; 10.0.2.2 is
#                             its documented alias for the host machine's loopback)
#      Physical Android    -> http://<your-LAN-IP>:54321   (device and dev machine
#      device               must be on the same network; do NOT commit this value --
#                             set it only in your own untracked .env.local)
#      iOS (cloud/EAS build only on this Windows dev machine -- no local simulator)
#
# Never put the SECRET_KEY, SERVICE_ROLE_KEY, JWT_SECRET or database
# password here -- those are server-only local dev credentials and must
# never be read by application code or bundled into the client. Any
# EXPO_PUBLIC_* variable is bundled into the client JS and is not a secret
# storage mechanism (https://docs.expo.dev/guides/environment-variables/).

EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
